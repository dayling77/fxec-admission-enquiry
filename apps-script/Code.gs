const CFG={SHEET:'Admission Leads',TTL:300,MAX:5,COOLDOWN:60};
function doGet(){return ContentService.createTextOutput(JSON.stringify({ok:true,service:'FXEC Admission Enquiry'})).setMimeType(ContentService.MimeType.JSON);}
function doPost(e){try{var p=JSON.parse(e.postData.contents||'{}');var r=p.action==='sendOtp'?sendOtp(p.lead):p.action==='verifyOtp'?verifyOtp(p):p.action==='submitLead'?submitLead(p):{ok:false,message:'Unknown action'};return ContentService.createTextOutput(JSON.stringify(r)).setMimeType(ContentService.MimeType.JSON);}catch(x){return ContentService.createTextOutput(JSON.stringify({ok:false,message:x.message})).setMimeType(ContentService.MimeType.JSON);}}
function P(){return PropertiesService.getScriptProperties();}
function H(s){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s).map(function(b){return ('0'+((b+256)%256).toString(16)).slice(-2)}).join('');}
function validate(p){var req=['studentName','modeOfStudy','district','schoolCategory','schoolName','xMarks','xMax','xiiExpected','xiiMax','scholarship','mobile','email','otpChannel'];req.forEach(function(k){if(p[k]===undefined||String(p[k]).trim()==='')throw Error('Complete all required fields.');});if(p.className!=='XII')throw Error('Invalid class');if(['Kanyakumari','Tirunelveli','Thoothukudi','Tenkasi','Virudhunagar'].indexOf(p.district)<0)throw Error('Invalid district');if(['Matriculation','CBSE','IGCSE','State Board – Government School','State Board – Government Aided School','Other / International Board'].indexOf(p.schoolCategory)<0)throw Error('Invalid school category');if(['email','whatsapp'].indexOf(p.otpChannel)<0)throw Error('Invalid OTP channel');var m=String(p.mobile).replace(/\D/g,'');if(!/^[6-9]\d{9}$/.test(m))throw Error('Enter a valid 10-digit Indian mobile number');var a=Number(p.xMarks),b=Number(p.xMax),c=Number(p.xiiExpected),d=Number(p.xiiMax);if(![a,b,c,d].every(Number.isFinite)||a<0||b<=0||c<0||d<=0||a>b||c>d)throw Error('Check obtained and maximum marks');if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(p.email)))throw Error('Enter a valid email');if(p.consent!==true)throw Error('Consent is required');return {studentName:String(p.studentName).trim(),modeOfStudy:String(p.modeOfStudy),district:p.district,schoolCategory:p.schoolCategory,schoolName:String(p.schoolName).trim(),xMarks:a,xMax:b,xiiExpected:c,xiiMax:d,scholarship:String(p.scholarship),mobile:m,email:String(p.email).trim().toLowerCase(),otpChannel:p.otpChannel};}
function sendOtp(input){var l=validate(input),dest=l.otpChannel==='email'?l.email:l.mobile,ck='COOL_'+H(l.otpChannel+':'+dest),lock=LockService.getScriptLock();lock.waitLock(10000);try{if(Date.now()-Number(P().getProperty(ck)||0)<CFG.COOLDOWN*1000)throw Error('Wait 60 seconds before requesting another OTP');var code=String(Math.floor(100000+Math.random()*900000)),id=Utilities.getUuid(),rec={hash:H(id+':'+code),lead:l,channel:l.otpChannel,expires:Date.now()+CFG.TTL*1000,attempts:0,verified:false};P().setProperty('OTP_'+id,JSON.stringify(rec));P().setProperty(ck,String(Date.now()));try{if(l.otpChannel==='email')MailApp.sendEmail(l.email,'FXEC Admission Enquiry OTP','Your verification code is '+code+'. It expires in five minutes. Do not share this code.');else sendInteraktOtp(l.mobile,code);}catch(x){P().deleteProperty('OTP_'+id);throw x;}return {ok:true,requestId:id};}finally{lock.releaseLock();}}
function verifyOtp(p){var id=String(p.requestId||''),code=String(p.code||'');if(!id||!/^[0-9]{6}$/.test(code))throw Error('Invalid OTP request');var lock=LockService.getScriptLock();lock.waitLock(10000);try{var key='OTP_'+id,raw=P().getProperty(key);if(!raw)throw Error('OTP request expired. Request a new code');var r=JSON.parse(raw);if(Date.now()>r.expires){P().deleteProperty(key);throw Error('OTP expired. Request a new code');}if(r.verified)return {ok:true};r.attempts++;if(r.attempts>CFG.MAX){P().deleteProperty(key);throw Error('Too many attempts. Request a new OTP');}if(H(id+':'+code)!==r.hash){P().setProperty(key,JSON.stringify(r));throw Error('Incorrect OTP');}r.verified=true;r.verifiedAt=Date.now();P().setProperty(key,JSON.stringify(r));return {ok:true};}finally{lock.releaseLock();}}
function submitLead(p){var id=String(p.requestId||''),lock=LockService.getScriptLock();lock.waitLock(10000);try{var key='OTP_'+id,raw=P().getProperty(key);if(!raw)throw Error('Verification expired. Verify again');var r=JSON.parse(raw);if(!r.verified||Date.now()>r.verifiedAt+600000)throw Error('Verify your contact again');var l=validate(p.lead||{});if(l.mobile!==r.lead.mobile||l.email!==r.lead.email||l.otpChannel!==r.channel)throw Error('Contact details changed. Verify again');var sid=P().getProperty('SPREADSHEET_ID');if(!sid)throw Error('Administrator has not configured SPREADSHEET_ID');var ss=SpreadsheetApp.openById(sid),sh=ss.getSheetByName(CFG.SHEET)||ss.insertSheet(CFG.SHEET);if(sh.getLastRow()===0){sh.appendRow(['Submission ID','Submitted At','Student Name','Class','Mode of Study','District','School Category','School Name','X Marks','X Maximum','XII Expected Marks','XII Maximum','Scholarship Interest','Mobile','Email','Verification Method','Status','Consent']);sh.setFrozenRows(1);}var sub=Utilities.getUuid();sh.appendRow([sub,new Date(),l.studentName,'XII',l.modeOfStudy,l.district,l.schoolCategory,l.schoolName,l.xMarks,l.xMax,l.xiiExpected,l.xiiMax,l.scholarship,l.mobile,l.email,r.channel,'Verified','Yes']);P().deleteProperty(key);return {ok:true,submissionId:sub};}finally{lock.releaseLock();}}
function sendInteraktOtp(mobile,code){var p=P();if(!p.getProperty('INTERAKT_API_KEY')||!p.getProperty('INTERAKT_OTP_ENDPOINT')||!p.getProperty('INTERAKT_AUTH_TEMPLATE_NAME'))throw Error('WhatsApp OTP is not configured. Choose Email OTP or contact the administrator.');throw Error('Interakt OTP adapter needs the exact endpoint, authentication header and approved template payload from the FXEC Interakt account.');}
